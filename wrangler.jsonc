{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "belegbox",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "belegbox.seiffert.me",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "belegbox",
      "database_id": "f0b282c6-9afb-4162-bbed-47cea50284e8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECEIPTS",
      "bucket_name": "belegbox-belege"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_PREFILL_ENABLED": "true"
  }
}
